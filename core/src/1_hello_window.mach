use std.runtime;
use std.chrono.duration.SECOND;
use boom;

# 固定时间步的游戏逻辑。
#
# Boom 会以 fixed_dt 指定的频率调用这个函数。
# 现在我们还没有游戏逻辑，所以暂时为空。
fun tick(ctx: *boom.context.Context) {
}

# 渲染阶段。
#
# 当前还没有学习 Renderer，所以暂时不画任何东西。
fun draw(ctx: *boom.context.Context) {
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    # Context 是 Boom 游戏运行时的核心上下文。
    #
    # 当前它会负责：
    # - 窗口
    # - 帧时钟
    # - fixed timestep 累加器
    # - 输入事件队列
    var ctx: boom.context.Context;

    # 创建游戏运行配置。
    val cfg: boom.context.Config = boom.context.Config{
        width:     1280,
        height:    720,
        title:     "Boom Example 01 - Hello Window",

        # 游戏逻辑以 60 Hz 的固定时间步运行。
        fixed_dt:  SECOND / 60,

        # 限制单帧最多追赶多少时间。
        #
        # 主要用于避免游戏严重卡顿之后，
        # 引擎为了追赶模拟时间而进入 spiral of death。
        max_frame: SECOND / 4,

        # 由 Boom 的时钟系统维护实际 frame delta。
        #
        # 这里设为 0 是官方示例中的初始值。
        frame_dt:  0,
    };

    # 创建 Context，同时创建窗口和运行时状态。
    #
    # 初始化失败时直接返回非 0 状态。
    if (!boom.context.context_init(?ctx, cfg)) {
        ret 1;
    }

    # 定义游戏生命周期。
    #
    # 当前：
    # f_init = 不使用
    # f_tick = 游戏逻辑
    # f_draw = 渲染
    # f_dnit = 不使用
    var app: boom.app.App = boom.app.App{
        f_init: nil::fun(*boom.context.Context),
        f_tick: tick,
        f_draw: draw,
        f_dnit: nil::fun(*boom.context.Context),
    };

    # 进入 Boom 游戏主循环。
    #
    # Boom 会负责：
    # 1. 处理窗口 / 输入事件
    # 2. 执行固定时间步 update
    # 3. 执行 render
    # 4. 处理窗口关闭
    #
    # run 返回最终程序状态。
    val status: i64 = boom.engine.run(?ctx, ?app);

    # 游戏循环结束后释放 Context 拥有的资源。
    boom.context.context_shutdown(?ctx);

    ret status;
}

