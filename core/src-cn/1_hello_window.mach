# ============================================================
# Boom 教程 01：Hello Window
#
# 本课目标：
#
# 1. 创建 Boom Context
# 2. 创建窗口
# 3. 建立 App 生命周期
# 4. 进入 Boom Game Loop
# 5. 正确关闭程序
#
# 本课暂时不涉及：
#
# - Renderer
# - Texture
# - Shader
# - Physics
# - Camera
# - Audio
#
# 我们先建立最基本的 Boom 程序生命周期。
# ============================================================


use std.runtime;

use std.chrono.duration.SECOND;
use std.chrono.duration.MILLISECOND;

use std.types.bool.bool;

use boom.context.Config;
use boom.context.Context;
use boom.context.context_init;
use boom.context.context_shutdown;

use boom.engine.run;
use boom.app.App;


# ============================================================
# on_init
#
# 游戏初始化阶段。
#
# Boom 在进入 Game Loop 后调用一次。
#
# 当前没有需要初始化的游戏资源，所以暂时为空。
# ============================================================
fun on_init(ctx: *Context) {
}


# ============================================================
# on_tick
#
# 固定时间步的游戏逻辑更新。
#
# 这里以后会放：
#
# - 玩家移动
# - 游戏状态更新
# - AI
# - Animation
# - Physics
#
# Boom 的 tick 使用 fixed timestep，
# 因此这里属于“游戏模拟”而不是单纯的画面刷新。
# ============================================================
fun on_tick(ctx: *Context) {
}


# ============================================================
# on_draw
#
# 渲染阶段。
#
# 当前还没有学习 Renderer，
# 所以这一课暂时不进行任何绘制。
# ============================================================
fun on_draw(ctx: *Context) {
}


# ============================================================
# on_dnit
#
# 游戏结束时调用一次。
#
# 以后这里会负责：
#
# - 销毁游戏资源
# - 释放 Texture
# - 释放 Mesh
# - 释放 Audio
# - 释放其他需要显式管理的资源
#
# 当前没有需要释放的游戏资源。
# ============================================================
fun on_dnit(ctx: *Context) {
}


# ============================================================
# main
#
# 程序入口。
# ============================================================
#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    # --------------------------------------------------------
    # 创建 App
    #
    # App 描述 Boom 的游戏生命周期。
    # --------------------------------------------------------
    var app: App;

    app.f_init = on_init;
    app.f_tick = on_tick;
    app.f_draw = on_draw;
    app.f_dnit = on_dnit;


    # --------------------------------------------------------
    # 创建 Context
    #
    # Context 是 Boom 的核心运行时上下文。
    #
    # 它负责管理：
    #
    # - Window
    # - Input
    # - Clock
    # - Fixed timestep accumulator
    # - 其他运行时状态
    # --------------------------------------------------------
    var ctx: Context;


    # --------------------------------------------------------
    # 配置 Boom
    # --------------------------------------------------------
    val cfg: Config = Config{
        width: 1280,
        height: 720,

        title: "Boom Example 01 - Hello Window",

        # 固定时间步：
        #
        # 1 秒 / 60
        #
        # 即：
        #
        # 0.016666... 秒
        # ≈ 16.67 ms
        #
        # 因此目标 Simulation Rate 为 60 Hz。
        fixed_dt: SECOND / 60,

        # 最大 Frame Delta：
        #
        # 限制一次 Frame 最多向模拟系统追赶多少时间。
        #
        # 主要用于避免严重卡顿时出现
        # Spiral of Death（死亡螺旋）。
        max_frame: 250 * MILLISECOND,

        # 第一课不需要预先设置实际 Frame Delta。
        frame_dt: 0,
    };


    # --------------------------------------------------------
    # 初始化 Context
    # --------------------------------------------------------
    #
    # context_init() 返回 bool：
    #
    # true
    #     初始化成功
    #
    # false
    #     初始化失败
    #
    # 注意：
    #
    # “false”是 context_init() 的返回值，
    # “ret 1”是我们自己的进程退出状态。
    #
    # 这两个概念不要混在一起。
    # --------------------------------------------------------
    if (!context_init(?ctx, cfg)) {
        # 初始化失败时返回 1。
        ret 1;
    }


    # --------------------------------------------------------
    # 进入 Boom Game Loop
    # --------------------------------------------------------
    #
    # Boom 会负责：
    #
    # Window / Input Poll
    #        ↓
    # Fixed Tick
    #        ↓
    # Render
    #        ↓
    # 下一帧
    #
    # 直到窗口被关闭。
    val status: i64 = run(?ctx, ?app);


    # --------------------------------------------------------
    # 关闭 Context
    #
    # Game Loop 结束以后，
    # 释放 Context 所拥有的运行时资源。
    # --------------------------------------------------------
    context_shutdown(?ctx);


    # 将 Boom 最终运行状态返回给操作系统。
    ret status;
}

