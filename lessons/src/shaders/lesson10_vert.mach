# Lesson 10: Vertex Shader
#
# This stage still uses the standard 3D VertexFormat:
#
#    Position
#    Normal
#    UV / TexCoord
#
# The focus of this lesson is not to change vertex processing,
# so the Vertex Shader is basically the same as in Lesson 09.

rec Matrices {
    mvp_0:   f32x4;
    mvp_1:   f32x4;
    mvp_2:   f32x4;
    mvp_3:   f32x4;
    model_0: f32x4;
    model_1: f32x4;
    model_2: f32x4;
    model_3: f32x4;
}

# binding 0:
# boom provides the matrix data needed for Model / View / Projection.
#[uniform(0, 0)]
var matrices: Matrices;

#[input(0)]
var in_position: f32x3;

#[input(1)]
var in_normal: f32x3;

#[input(2)]
var in_uv: f32x2;

#[output(0)]
var out_normal: f32x3;

#[output(1)]
var out_uv: f32x2;

#[builtin("position")]
var position: f32x4;

# A 4×4 Matrix in Mach Shader is represented by four f32x4 columns.
#
# Mat4 is Column-major.
fun mul_point(
    c0: f32x4,
    c1: f32x4,
    c2: f32x4,
    c3: f32x4,
    p: f32x4,
) f32x4 {
    ret c0 * f32x4{p[0], p[0], p[0], p[0]}
        + c1 * f32x4{p[1], p[1], p[1], p[1]}
        + c2 * f32x4{p[2], p[2], p[2], p[2]}
        + c3 * f32x4{p[3], p[3], p[3], p[3]};
}

#[stage("vertex")]
fun vert_main() {
    val p: f32x4 = f32x4{
        in_position[0],
        in_position[1],
        in_position[2],
        1.0,
    };

    # Model → View → Projection.
    position = mul_point(
        matrices.mvp_0,
        matrices.mvp_1,
        matrices.mvp_2,
        matrices.mvp_3,
        p,
    );

    # This lesson does not use Normal lighting,
    # but still passes it through to maintain the standard Vertex Shader structure.
    out_normal = in_normal;
    out_uv = in_uv;
}

