# Lesson 15 Fragment Shader
#
# Processing order for the current image:
#
#     RenderTarget Texture
#             ↓
#        tex.sample_2d()
#             ↓
#          Vignette
#             ↓
#         Color Tint
#             ↓
#        final color
#
# The Vignette from Lesson 14 is kept here.
#
# New in Lesson 15:
#
#     binding 4 → Params
#
#     Params.tint:
#         Tint target color
#
#     Params.amount.x:
#         Tint strength

use tex: shader.texture;

rec Params {
    tint: f32x4;
    amount: f32x4;
}

#[sampler(0, 1)]
var source: tex.Sampler2D;

#[uniform(0, 4)]
var params: Params;

#[input(0)]
var in_uv: f32x2;

#[output(0)]
var out_colour: f32x4;

#[stage("fragment")]
fun frag_main() {
    # --------------------------------------------------------
    # Lesson 13: read the RenderTarget Texture
    # --------------------------------------------------------
    val texel: f32x4 =
        tex.sample_2d(source, in_uv);

    # --------------------------------------------------------
    # Lesson 14: Vignette
    # --------------------------------------------------------
    #
    # UV:
    #
    #     0.0 ~ 1.0
    #
    # Move the center to:
    #
    #     0.0
    #
    # Final range:
    #
    #     -1.0 ~ +1.0
    val centered_x: f32 =
        (in_uv[0] - 0.5) * 2.0;

    val centered_y: f32 =
        (in_uv[1] - 0.5) * 2.0;

    # Squared distance to the screen center.
    val radius2: f32 =
        centered_x * centered_x
        + centered_y * centered_y;

    # Vignette strength.
    #
    # Keep the Lesson 14 effect here, without using a new Uniform,
    # so that Lesson 15 can focus on the Tint Uniform.
    val vignette_strength: f32 = 0.55 + params.amount[0] * 0.65;
    var vignette: f32 = 1.0 - radius2 * vignette_strength;

    if (vignette < 0.0) {
        vignette = 0.0;
    }

    # Apply the Lesson 14 Vignette first.
    val vignetted: f32x4 = f32x4{
        texel[0] * vignette,
        texel[1] * vignette,
        texel[2] * vignette,
        texel[3]
    };

    # --------------------------------------------------------
    # Lesson 15: Color Tint
    # --------------------------------------------------------
    #
    # The Tint target color comes from the CPU:
    #
    #     binding 4
    #
    # amount.x controls the Tint strength.
    val amount: f32 =
        params.amount[0];

    # Multiply the Vignetted color by the Tint.
    val tinted: f32x4 = f32x4{
        vignetted[0] * params.tint[0],
        vignetted[1] * params.tint[1],
        vignetted[2] * params.tint[2],
        vignetted[3]
    };

    # 0.0:
    #
    #     only show the Vignetted original image
    #
    # 1.0:
    #
    #     fully use the Tinted color
    out_colour = f32x4{
        vignetted[0] + (tinted[0] - vignetted[0]) * amount,
        vignetted[1] + (tinted[1] - vignetted[1]) * amount,
        vignetted[2] + (tinted[2] - vignetted[2]) * amount,
        vignetted[3]
    };
}

