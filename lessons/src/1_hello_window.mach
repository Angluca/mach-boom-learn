# Example 01 - Hello Window
#
# This example studies the most basic program structure of Boom:
#
# 1. Context
#    Manages the state needed by the window, input, clock, and game loop.
#
# 2. Window
#    The game window is created when the Context is initialized.
#
# 3. App (application lifecycle)
#    Connects the different lifecycle stages of the game with
#    f_init, f_tick, f_draw, and f_dnit.
#
# 4. Game Loop
#    Boom continuously executes:
#
#    Tick → Draw → Tick → Draw ...
#
# This lesson does not use Renderer yet.
# The focus is simply understanding how a Boom program starts, runs, and exits.

use std.runtime;
use std.print;
use std.chrono.duration.SECOND;
use std.chrono.duration.MILLISECOND;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;

use boom.app.App;
use boom.context.Config;
use boom.context.Context;
use boom.context.ContextError;
use boom.context.context_error_message;
use boom.context.context_init;
use boom.context.context_shutdown;
use boom.context.context_set_user;
use boom.context.context_user;
use boom.engine.EngineError;
use boom.engine.engine_error_message;
use boom.engine.run;
use boom.window.WindowMode;

rec Game {
    # This example currently only stores initialization state.
    ready: bool;
}

fun on_init(ctx: *Context) {
    val g: *Game = context_user(ctx)::*Game;
    g.ready = true;

    print.println("Hello Window!");
}

fun on_tick(ctx: *Context) {
    val g: *Game = context_user(ctx)::*Game;
    if (!g.ready) {
        ret;
    }

    # Tick is used to update game state.
}

fun on_draw(ctx: *Context) {
    val g: *Game = context_user(ctx)::*Game;
    if (!g.ready) {
        ret;
    }

    # This lesson does not have a Renderer yet, so no GPU content
    # is drawn here for now.
}

fun on_dnit(ctx: *Context) {
    val g: *Game = context_user(ctx)::*Game;
    if (!g.ready) {
        ret;
    }

    # Release your own resources here when the game exits.
    g.ready = false;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var game: Game;

    # App is responsible for wiring game code into Boom's lifecycle.
    var app: App;
    app.f_init = on_init;
    app.f_tick = on_tick;
    app.f_draw = on_draw;
    app.f_dnit = on_dnit;

    var ctx: Context;
    val cfg: Config = Config{
        width:     960,
        height:    540,
        title:     "Lesson 01: Hello Window",
        fixed_dt:  SECOND / 60,
        max_frame: 250 * MILLISECOND,
        frame_dt:  0,
        mode:      WindowMode.windowed{},
    };

    # context_init() now returns err[ContextError].
    #
    # sel is Mach's new Tag/Result checking method:
    #
    #    started.err
    #        indicates that initialization failed.
    #
    #    ContextError tells at which stage the failure occurred.
    val started: err[ContextError] = context_init(?ctx, cfg);
    if (sel started.err) {
        print.eprintlnf(
            "Context initialization failed: {}",
            context_error_message(started.err),
        );
        ret 1;
    }

    # Give the Game state to the Context.
    context_set_user(
        ?ctx,
        (?game)::ptr,
    );

    # run() now returns res[i64, EngineError].
    #
    # ok:
    #    The game stopped normally and carries the final exit status.
    #
    # err:
    #    The game loop itself encountered an error.
    val ran: res[i64, EngineError] = run(?ctx, ?app);

    # run() already calls f_dnit internally.
    # So here we finally shut down the Context.
    val closed: err[ContextError] = context_shutdown(?ctx);
    if (sel closed.err) {
        print.eprintlnf(
            "Context shutdown failed: {}",
            context_error_message(closed.err),
        );
        ret 1;
    }

    if (sel ran.err) {
        print.eprintlnf(
            "Game loop failed: {}",
            engine_error_message(ran.err),
        );
        ret 1;
    }

    ret ran.ok;
}

