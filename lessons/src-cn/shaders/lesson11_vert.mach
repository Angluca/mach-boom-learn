# 第 11 课：Vertex Shader（顶点着色器）
#
# 本课的 Vertex Shader 基本保持不变。
#
# Storage Buffer 的读取发生在 Fragment Shader，
# 因此这里继续负责：
#
#    Position（位置）
#    Normal（法线）
#    UV / TexCoord（纹理坐标）
#
# 并完成：
#
#    Model → View → Projection
#
# 的位置变换。

rec Matrices {
    mvp_0:   f32x4;
    mvp_1:   f32x4;
    mvp_2:   f32x4;
    mvp_3:   f32x4;
    model_0: f32x4;
    model_1: f32x4;
    model_2: f32x4;
    model_3: f32x4;
}

# binding 0：
# boom 提供 Model / View / Projection 数据。
#[uniform(0, 0)]
var matrices: Matrices;

#[input(0)]
var in_position: f32x3;

#[input(1)]
var in_normal: f32x3;

#[input(2)]
var in_uv: f32x2;

#[output(0)]
var out_normal: f32x3;

#[output(1)]
var out_uv: f32x2;

#[builtin("position")]
var position: f32x4;

# Matrix（矩阵）按四个 f32x4 列表示。
fun mul_point(
    c0: f32x4,
    c1: f32x4,
    c2: f32x4,
    c3: f32x4,
    p: f32x4,
) f32x4 {
    ret c0 * f32x4{p[0], p[0], p[0], p[0]}
        + c1 * f32x4{p[1], p[1], p[1], p[1]}
        + c2 * f32x4{p[2], p[2], p[2], p[2]}
        + c3 * f32x4{p[3], p[3], p[3], p[3]};
}

#[stage("vertex")]
fun vert_main() {
    val p: f32x4 = f32x4{
        in_position[0],
        in_position[1],
        in_position[2],
        1.0,
    };

    # Model → View → Projection。
    position = mul_point(
        matrices.mvp_0,
        matrices.mvp_1,
        matrices.mvp_2,
        matrices.mvp_3,
        p,
    );

    # 本课不使用法线和 UV，
    # 但继续保留标准接口。
    out_normal = in_normal;
    out_uv = in_uv;
}

