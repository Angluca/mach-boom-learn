# 第18课 Vertex Shader（顶点着色器）
#
# 第二 Pass 使用 Full-screen Quad。
#
# Position：
#
#     Quad → Clip Space
#
# UV：
#
#     原样传给 Fragment Shader。
#
# Blur、Pixelation、Chromatic Aberration、
# Vignette 和 Color Tint 都在 Fragment Shader 中完成。
#
# Matrix 在当前 Shader 中不是 f32x4x4，
# 而是拆成四个 f32x4，通过 mul_point() 完成乘法。

rec Matrices {
    mvp_0:   f32x4;
    mvp_1:   f32x4;
    mvp_2:   f32x4;
    mvp_3:   f32x4;
    model_0: f32x4;
    model_1: f32x4;
    model_2: f32x4;
    model_3: f32x4;
}

#[uniform(0, 0)]
var matrices: Matrices;

#[input(0)]
var in_position: f32x3;

#[input(2)]
var in_uv: f32x2;

#[output(0)]
var out_uv: f32x2;

#[builtin("position")]
var position: f32x4;

fun mul_point(
    c0: f32x4,
    c1: f32x4,
    c2: f32x4,
    c3: f32x4,
    p: f32x4
) f32x4 {
    ret c0 * f32x4{
        p[0], p[0], p[0], p[0]
    } + c1 * f32x4{
        p[1], p[1], p[1], p[1]
    } + c2 * f32x4{
        p[2], p[2], p[2], p[2]
    } + c3 * f32x4{
        p[3], p[3], p[3], p[3]
    };
}

#[stage("vertex")]
fun vert_main() {
    val p: f32x4 = f32x4{
        in_position[0],
        in_position[1],
        in_position[2],
        1.0
    };

    position = mul_point(
        matrices.mvp_0,
        matrices.mvp_1,
        matrices.mvp_2,
        matrices.mvp_3,
        p
    );

    out_uv = in_uv;
}

