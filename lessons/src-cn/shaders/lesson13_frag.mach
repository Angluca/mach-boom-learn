# 第13课：Post-processing Fragment Shader（后处理片段着色器）
#
# 第一 Pass：
#
#     3D Scene
#         ↓
#     RenderTarget
#
# 第二 Pass：
#
#     RenderTarget Texture
#         ↓
#     Fragment Shader
#         ↓
#     Window
#
# 当前 Shader 做最简单的 Post-processing：
#
#     amount = 0.0
#         → 原始颜色
#
#     amount = 1.0
#         → 完全灰度
#
#     0.0 ~ 1.0
#         → 原图和灰度图混合
use tex: shader.texture;

rec Params {
    amount: f32x4;
}

# Material 的第一张 Texture：
#
#     binding 1
#
# 这里就是第12/13课 RenderTarget 的 Color Texture。
#[sampler(0, 1)]
var source: tex.Sampler2D;

# Game 自己提供的 Uniform：
#
#     binding 4
#[uniform(0, 4)]
var params: Params;

# Vertex Shader 传过来的 UV。
#[input(0)]
var in_uv: f32x2;

# 当前 Pixel 的最终颜色。
#[output(0)]
var out_colour: f32x4;

# OpImageSampleImplicitLod：
#
# 从 Texture 中按照 UV 采样当前颜色。
# tex.sample_2d 是一样的功能 直接可用, 这里只是做演示
#[op("spirv", "core", "OpImageSampleImplicitLod")]
fun sample_texture(
    sampler: tex.Sampler2D,
    uv: f32x2
) f32x4;

#[stage("fragment")]
fun frag_main() {
    # --------------------------------------------------------
    # 从 RenderTarget Texture 读取当前颜色
    # --------------------------------------------------------
    val texel: f32x4 =
        sample_texture(
            source,
            in_uv
        );

    # --------------------------------------------------------
    # 计算灰度
    # --------------------------------------------------------
    #
    # 使用常见的感知亮度权重：
    #
    #     Red   × 0.299
    #     Green × 0.587
    #     Blue  × 0.114
    #
    # 这样得到的灰度并不是简单的：
    #
    #     (R + G + B) / 3
    #
    # 而是根据人眼对不同颜色的亮度感知进行加权。
    val gray: f32 =
        texel[0] * 0.299
        + texel[1] * 0.587
        + texel[2] * 0.114;

    # --------------------------------------------------------
    # 原图与灰度图混合
    # --------------------------------------------------------
    #
    # amount：
    #
    #     0.0 → 原图
    #     1.0 → 灰度
    val amount: f32 =
        params.amount[0];

    val red: f32 =
        texel[0]
        + (gray - texel[0]) * amount;

    val green: f32 =
        texel[1]
        + (gray - texel[1]) * amount;

    val blue: f32 =
        texel[2]
        + (gray - texel[2]) * amount;

    # Alpha 直接保留 RenderTarget 的值。
    out_colour =
        f32x4{
            red,
            green,
            blue,
            texel[3]
        };
}

